// Prisma schema for Prod Spec
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// Better-Auth tables
// Field shape matches Better-Auth's expected schema.
// =====================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  role          UserRole @default(REVIEWER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  reviewActions    ReviewAction[]
  reviewedAssets   JobAsset[]        @relation("AssetReviewer")
  rejectionTickets RejectionTicket[] @relation("TicketReporter")
  notifications    UserNotification[]
  invitesSent      Invite[]          @relation("InvitesSent")
  acceptedInvite   Invite?           @relation("InviteAccepted")
  claimedReviews   Job[]             @relation("ReviewClaimer")
  styleViews       StyleView[]
  presence         UserPresence?

  @@map("users")
}

enum UserRole {
  ADMIN
  REVIEWER
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Single-use signup invitations — the only door into the app once the
// first admin exists (see databaseHooks in src/lib/auth.ts). Status is
// derived, never stored: usedAt → Used, revokedAt → Revoked,
// expiresAt < now → Expired, else Pending (the only state a link works in).
// Rows are kept after use as an audit trail of who invited whom.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique // random, rides in the /signup?invite= link
  email       String // invitee, stored lower-cased
  role        UserRole  @default(REVIEWER) // role the new user gets
  expiresAt   DateTime
  usedAt      DateTime? // set on first successful signup
  usedById    String?   @unique
  revokedAt   DateTime? // admin cancelled it
  invitedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invitedBy User  @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteAccepted", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}

// Per-output supplier delivery (per-output refactor, phase 3). One row per
// (style × output): when a single approved output is delivered to the supplier,
// deliveredAt + emailLogId are stamped so a re-run doesn't re-notify. Standalone
// (scalar refs, no relations) so adding it never changes existing model selects.
// Written/queried only behind PER_OUTPUT_DELIVERY_ENABLED (default off).
model OutputDelivery {
  id          String    @id @default(cuid())
  styleId     String
  variantKey  String
  jobAssetId  String?
  deliveredAt DateTime?
  emailLogId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([styleId, variantKey])
  @@index([styleId])
  @@map("output_deliveries")
}

// Per-(style × output) operator ignore — "this output is not wanted for THIS
// style". Set from the review surfaces (the Ignore button between Reject and
// Approve). An ignored output behaves like a doc-type exclusion scoped to one
// style: never (re)generated, never uploaded to SharePoint, never in the
// nightly supplier email; it counts as decided, not pending. Undoable (row
// delete) — any existing asset resurfaces for review. Loose styleId ref and no
// relations (matching OutputDelivery) so adding it never changes existing
// model selects; all reads are fail-soft until db:deploy lands the table.
model StyleOutputIgnore {
  id          String   @id @default(cuid())
  styleId     String
  variantKey  String // BASE key ("care-label-02", "layout:<id>") or "doc:<TYPE>" for legacy null-key assets
  outputName  String? // display snapshot for logs / the undo UI
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([styleId, variantKey])
  @@index([styleId])
  @@map("style_output_ignores")
}

// Per-(style × output × field) reviewer-supplied value — "on THIS style's copy
// of THIS output, use this string for this field". Set inline on the review
// surfaces (fill a missing/blocked field so the output can generate, or
// override a value on an already-generated output). It composes with the
// ProdSpec output's `fieldOverrides` pins — the per-style value wins — and
// flows through the SAME machinery: `pinnedColumnKeys` (so readiness/the runner
// treat the field as filled and stop skipping the output) and
// `applyFieldOverrides` (so it prints). `field` is a PinnableField key; `value`
// is a non-empty string (rows are deleted, not blanked, to clear). Loose
// styleId ref and no relations (matching StyleOutputIgnore / OutputDelivery) so
// adding it never changes existing model selects; all reads are fail-soft until
// db:deploy lands the table.
model StyleOutputFieldValue {
  id          String   @id @default(cuid())
  styleId     String
  variantKey  String // BASE key ("care-label-02", "layout:<id>") or "doc:<TYPE>" — see ignoreBaseKey
  field       String // PinnableField key, e.g. "colourName", "composition", "lot"
  value       String
  outputName  String? // display snapshot for logs
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([styleId, variantKey, field])
  @@index([styleId])
  @@map("style_output_field_values")
}

// Per-(style × output × LINE) reviewer text overrides — the catch-all escape
// hatch beside StyleOutputFieldValue. A field value fixes DATA (and therefore
// every output using it); a line value rewrites ONE line of ONE document,
// including layout text that is hardcoded and backed by no column at all
// ("Inner box: 8 pair") — which no field edit can ever reach.
//
// `lineKey` addresses the line within the layout definition as
// "<pageId>|<blockId>|<lineIndex>" (see lineOverrideKey). Both ids are stable:
// LayoutPage.id is required by the schema and parseLayoutDef injects a
// deterministic LayoutBlock.id into every block.
//
// `value` is a SOURCE line, not literal output — tokens and {{if}} conditionals
// inside it resolve exactly as an authored line would, so a reviewer can type
// plain text OR repoint the line at a different token. Max length mirrors
// LayoutBlockSchema's per-line 500-char cap.
model StyleOutputLineValue {
  id          String   @id @default(cuid())
  styleId     String
  // BASE key ("layout:<id>") = every PDF of the output; "<base>#<suffix>" =
  // one document of a repeat-per-EAN output. Same convention as
  // StyleOutputFieldValue / StyleOutputIgnore.
  variantKey  String
  lineKey     String
  value       String
  outputName  String? // display snapshot for logs
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([styleId, variantKey, lineKey])
  @@index([styleId])
  @@map("style_output_line_values")
}

// Nightly supplier-send queue (WS2). One row per approved (style, output).
// Populated the moment an output is approved (manual or auto) — ALWAYS, even
// while sending is flag-gated off — so /settings/approved can show exactly
// what WOULD be pushed + emailed. The midnight cron (WS2b) groups unsent rows
// by supplier → customer, sends one digest per supplier, and stamps sentAt.
// Loose styleId ref (no FK), matching OutputDelivery — rows survive style
// deletes and carry denormalized routing for fast grouping.
model SupplierSendQueueItem {
  id               String    @id @default(cuid())
  styleId          String
  variantKey       String
  jobAssetId       String? // the approved asset carrying the PDF at enqueue time
  docType          String
  displayName      String?
  // Denormalized routing, resolved at enqueue. supplierId null when the style
  // has no linked supplier yet (surfaced as "no supplier" on the overview).
  customerId       String
  supplierId       String?
  poSeq            Int? // numeric PO for the per-customer C-PO cutoff (WS7)
  // Eager SharePoint push result (WS2b). PENDING until pushed; UPLOADED with a
  // webUrl; FAILED (retryable) or SKIPPED (e.g. below PO cutoff / no config).
  sharePointStatus String    @default("PENDING")
  sharePointUrl    String?
  // The "APPROVED LAYOUTS" subfolder the PDF(s) landed in (targetFolderUrl from
  // the push). Persisted so /settings/approved can deep-link straight to the
  // folder, and so the self-heal verify (WS4) re-checks the exact location
  // without re-deriving it. Distinct from sharePointUrl (the file itself).
  sharePointFolderUrl String?
  // When AMBIGUOUS (several folders in the supplier's SharePoint match this PO —
  // employees must keep exactly one), the competing folders as a JSON string of
  // [{name, webUrl}] so /style + /settings/approved can link each and a reviewer
  // can delete the extra. Null in every other state. String (not Json) so the
  // sweep can clear it with a plain null (no Prisma DbNull dance).
  sharePointFolderMatches String?
  // Last push failure, human-readable ("400 · The file name is invalid", "403 ·
  // write not granted"). Written on every FAILED/SKIPPED/flagged stamp, cleared
  // on UPLOADED — so /settings/approved can say WHY a row floated instead of a
  // bare "gave up (3×)". Best-effort: written in its own guarded update so it
  // can't break the core status stamp before the column exists.
  sharePointError  String?
  // Consecutive FAILED folder pushes (WS3). Mirrors Style.eanAttempts: the
  // recurring upload sweep stops retrying a row at MAX_PUSH_ATTEMPTS and it
  // "floats" on /settings/approved; the midnight sweep still retries nightly.
  // Reset when a NEW render re-arms the row. lastPushAt = most recent attempt
  // (any outcome), for the overview.
  pushAttempts     Int       @default(0)
  lastPushAt       DateTime?
  // Self-heal verify (WS4). UPLOADED is otherwise set on a non-throwing Graph
  // PUT and NEVER re-checked, so a file that later moved (legacy folder scheme),
  // got cleaned up, or landed somewhere the supplier can't browse stays
  // "uploaded" forever. sharePointVerifiedAt = when the recurring sweep last
  // CONFIRMED this row's file is actually in the folder; null = never verified
  // or just re-armed. The verify pass re-checks rows past a TTL; a folder-
  // resolves-but-file-missing result re-arms the row to PENDING to re-upload.
  sharePointVerifiedAt DateTime?
  // Send lifecycle. sentAt stamped by the midnight batch; null = still pending.
  queuedAt         DateTime  @default(now())
  sentAt           DateTime?
  emailLogId       String?
  batchId          String? // links to SupplierSendBatch (added in WS2b)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([styleId, variantKey])
  @@index([supplierId, sentAt])
  @@index([sentAt])
  @@index([customerId])
  // Self-heal verify picks UPLOADED rows oldest-verified-first (nulls first).
  @@index([sharePointStatus, sharePointVerifiedAt])
  @@map("supplier_send_queue_items")
}

// One row per nightly supplier-send run (or a manual retry). Records what the
// batch did — how many suppliers/outputs, sent vs simulated vs skipped — so the
// /settings/approved history tab and any retry can read it back. Per-supplier
// detail lives in perSupplier JSON. Mirrors the CronRun/BulkRunBatch pattern.
model SupplierSendBatch {
  id             String    @id @default(cuid())
  // "midnight" (cron) | "manual" (admin retry button)
  source         String    @default("midnight")
  // How the run resolved overall: DRY_RUN (flag off), SENT, PARTIAL, FAILED, EMPTY.
  status         String    @default("DRY_RUN")
  supplierCount  Int       @default(0)
  outputCount    Int       @default(0)
  sentCount      Int       @default(0)
  // [{ supplierId, supplierName, email, styleCount, outputCount, status, emailLogId?, error? }]
  perSupplier    Json      @default("[]")
  note           String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Follow-up messaging (/settings/approved → "Recent sends" → "Send email to
  // suppliers"): when an admin last sent a custom message to this batch's
  // suppliers, and how many suppliers it reached. Purely a record — the emails
  // themselves are EmailLog rows of type SUPPLIER_MESSAGE. Kept on the batch so
  // the row can show that a correction already went out, which is what stops
  // the same 40 suppliers being apologised to twice.
  followUpAt     DateTime?
  followUpCount  Int       @default(0)

  @@index([createdAt])
  @@map("supplier_send_batches")
}

// =====================================================
// Domain — Monday mirrors + ProdSpec
//
// Customer / Supplier / BusinessArea rows are mirrored from Monday boards
// (see src/lib/monday/sync.ts). We never delete remote records from code;
// rows whose Monday source has disappeared get marked `active = false`.
// =====================================================

model Customer {
  id               String    @id @default(cuid())
  slug             String    @unique
  // Monday item id on board 3317892788. Nullable so legacy / hand-rolled
  // rows (e.g. the seeded netto-germany used by the manual-style form) can
  // exist without a Monday source.
  mondayItemId     String?   @unique
  // = Monday "Account" column
  name             String
  priority         String?
  salesResponsible String?
  country          String?
  location         String?
  lastSyncedAt     DateTime?
  active           Boolean   @default(true)
  // Customer-wide knobs — barcode font, logo URL, etc. See
  // src/lib/customers/config.ts for the parsed shape.
  config           Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  templates     Template[]
  styles        Style[]
  prodSpecs     ProdSpec[]
  outputLayouts OutputLayout[]

  customerBusinessAreaCombos CustomerBusinessAreaCombo[]

  @@index([active])
  @@map("customers")
}

model Supplier {
  id            String    @id @default(cuid())
  mondayItemId  String    @unique
  name          String
  purchaser     String?
  address       String?
  location      String?
  postCode      String?
  country       String?
  sharepointUrl String?
  // Supplier contact details, mirrored from the Monday suppliers board.
  // `email` is the supplier's main inbox (To: on the review email);
  // `contactEmail` is the named contact person at the supplier (CC:);
  // `contactName` is that person's display name. All optional — when the
  // board column is unmapped or blank the approval flow falls back to
  // SUPPLIER_NOTIFICATION_EMAIL.
  email         String?
  contactEmail  String?
  contactName   String?
  lastSyncedAt  DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  styles            Style[]
  prodSpecSuppliers ProdSpecSupplier[]
  contacts          SupplierContact[]

  @@index([active])
  @@map("suppliers")
}

// Contact PEOPLE at a supplier, mirrored from the Monday "Supplier Contacts"
// board (3363269178). Each contact links to its Supplier Company via the
// board-relation column; contacts whose linked company isn't mirrored (or
// who have no link) keep supplierId null. Email sending resolves recipients
// through these rows (see src/lib/suppliers/recipients.ts): Active
// "Product Supplier" contacts receive the supplier emails; the legacy
// Supplier.email/contactEmail fields stay as fallback.
model SupplierContact {
  id           String    @id @default(cuid())
  mondayItemId String    @unique
  name         String
  // "Title" text column (job title, e.g. "Merchandiser"). Often blank.
  title        String?
  email        String?
  phone        String?
  // "Type" status column — "Product Supplier" | "Cost Supplier" | "–".
  contactType  String?
  // "Status" status column — "Active" | "Passive".
  status       String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime?
  // false = the Monday item disappeared from the board (never deleted).
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([supplierId])
  @@index([active])
  @@map("supplier_contacts")
}

// Mirrored options from the BusinessArea dropdown on the Styles board.
// `mondayValue` is the raw label as it lives in Monday; `name` is the
// editable display we render in our UI.
//
// `mergedIntoId` makes this BA an alias of another. Set via the admin
// merge tool when Monday has duplicate variants for the same concept
// (e.g. "PL" and "Private Label"). Ingest follows the redirect so
// future Monday items with the alias mondayValue still resolve to the
// canonical BA's Styles / ProdSpecs.
model BusinessArea {
  id           String    @id @default(cuid())
  mondayValue  String    @unique
  name         String
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  mergedIntoId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  mergedInto    BusinessArea?  @relation("BusinessAreaMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  aliases       BusinessArea[] @relation("BusinessAreaMerge")
  styles        Style[]
  prodSpecs     ProdSpec[]
  outputLayouts OutputLayout[]

  customerBusinessAreaCombos CustomerBusinessAreaCombo[]

  @@index([active])
  @@index([mergedIntoId])
  @@map("business_areas")
}

// =====================================================
// Customer × Business-Area combo registry. One row per distinct
// (customer, business area) pair ever seen among ACTIVE styles — the same
// active set the /styles list shows (see src/lib/styles/active-filter.ts).
// A newly-appearing combo is flagged NEW and stages a heads-up email so the
// admin can give it a first look and build a ProdSpec / make PDFs from spec.
//
// Rows are kept as history even after a combo's last active style is gone
// (activeStyleCount → 0, row retained). notifiedAt is stamped once and never
// reset, so a combo that reappears later is not re-emailed. The very first
// reconcile (empty registry) seeds the current landscape as REVIEWED with
// notifiedAt set — a baseline, not a flood of alerts.
//   - baKey: non-null unique discriminator (NULL-in-unique-index trap):
//       resolved BA → the businessAreaId
//       free-text-only → "freetext:<lowercased, whitespace-collapsed>"
//       no business area → "none"
//   - baLabel / customerName: display snapshots refreshed each reconcile.
//   - exampleStyleId: loose ref (no FK) for a dashboard deep link, like
//     EmailLog.styleId — the registry must outlive any single style.
// =====================================================
model CustomerBusinessAreaCombo {
  id               String      @id @default(cuid())
  customerId       String
  businessAreaId   String?
  baKey            String
  baLabel          String
  customerName     String
  status           ComboStatus @default(NEW)
  firstSeenAt      DateTime    @default(now())
  lastSeenAt       DateTime    @default(now())
  notifiedAt       DateTime?
  reviewedAt       DateTime?
  activeStyleCount Int         @default(0)
  exampleStyleId   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessArea BusinessArea? @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)

  @@unique([customerId, baKey])
  @@index([status])
  @@index([notifiedAt])
  @@index([customerId])
  @@index([businessAreaId])
  @@map("customer_business_area_combos")
}

enum ComboStatus {
  NEW // detected after baseline, awaiting the admin's first look
  REVIEWED // admin acknowledged / built the ProdSpec (or seeded at baseline)
}

// Language is the canonical translation namespace. Every JSON translation
// map in the app (WashSymbol.translations, Country.nameTranslations,
// ProdSpec.careInstructionsByLang) uses Language.code as its key.
//
// Decoupled from Country because the relationship isn't 1:1 — e.g.
// Switzerland speaks de-CH / fr-CH / it-CH; Austrian German (de-AT) is
// a regional variant of German. Operators manage the *set of supported
// languages* here; Country points to one of them as its primary language.
model Language {
  id         String   @id @default(cuid())
  // BCP 47 / ISO 639-1 code — "en", "da", "de-AT", "nl-BE". Lowercase
  // language part, uppercase region part. Used as the JSON key for every
  // translation map. Immutable after create (renaming orphans existing
  // translations).
  code       String   @unique
  // English name shown in admin lists ("English", "Austrian", "Swiss").
  name       String
  // Self-language name (endonym) — "Dansk", "Deutsch", "Österreichisch".
  // Optional; shown alongside `name` to disambiguate similar languages.
  nativeName String?
  active     Boolean  @default(true)
  // Sort order in dialog grids — useful when an operator wants "English
  // first, Danish second, German third". Defaults to alphabetical via
  // ordered seeding.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
  @@map("languages")
}

// Country is a geographic entity — used for Customer / Supplier addresses
// and the eventual Style.countryOfOrigin field. Points to a primary
// Language via `languageCode` (informal reference, not a FK).
//
// Holds *its own* name in other languages — "Made in China" needs to
// render as "Fremstillet i Kina" / "Fabriqué en Chine" / "Wyprodukowano
// w Chinach" depending on label language. Key for nameTranslations is
// Language.code.
model Country {
  id               String   @id @default(cuid())
  // ISO 3166-1 alpha-2 (DK, DE, CN, ...). Unique so seeding is idempotent.
  code             String   @unique
  // English name — canonical fallback when no translation exists.
  nameEn           String
  // ISO 639-1 lowercase language code (da, de, zh, ...). The JSON key
  // every translation map uses. Two countries sharing a language (US + GB
  // → en) only need the translation set once.
  languageCode     String
  // Translations of *this country's name itself* in each language.
  // { da: "Kina", de: "China", fr: "Chine", pl: "Chiny", ... }
  nameTranslations Json     @default("{}")
  active           Boolean  @default(true)
  // Raw value Monday emits when sync'ing the country-of-origin column.
  // Optional — only relevant once a Monday column for it exists.
  mondayValue      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
  @@index([languageCode])
  @@index([mondayValue])
  @@map("countries")
}

// First-class config bundle for one Customer × BusinessArea combo. Holds
// the per-output PDF dimensions, the attached suppliers, the required-
// field set, and the auto-generation threshold.
model ProdSpec {
  id                       String   @id @default(cuid())
  customerId               String
  businessAreaId           String
  // Auto-derived from "<Customer name> · <BusinessArea name>" but editable.
  name                     String
  // Per-doc-type config: { WASHCARE: { enabled: true, widthMm: 30, heightMm: 60 }, ... }
  // See ProdSpecOutputsSchema in src/lib/prod-spec/config.ts.
  outputs                  Json     @default("{}")
  // Optional logo (SVG markup) used by templates that render a
  // customer × business-area branded header (e.g. care-label-01). Stored
  // as text so it travels with the row and inlines into the PDF without
  // a network fetch.
  logoSvg                  String?
  // Markdown source for the "General information" A4 page (general
  // requirements, inspection standards — GFM tables supported). Written
  // once per ProdSpec in the editor's General information tab, rendered
  // via marked → renderPdf, and included in every generated bundle as
  // 01-…-general-information.pdf. Null/empty ⇒ no page emitted.
  generalInfoMd            String?
  // Per-page print settings for the bundle framing pages: margins (mm,
  // page edge → content), base font size (pt), line height and footer
  // toggle — one block each for the cover page and the general
  // information page. Shape { cover: {...}, generalInfo: {...} }; see
  // BundlePageSettingsSchema in src/lib/prod-spec/config.ts. Empty
  // object ⇒ defaults.
  bundlePageSettings       Json     @default("{}")
  // Multilingual care-instruction strings rendered on care-label-02 back.
  // Shape: { en: "Wash with similar colours / ...", da: "vaskes med ...", ... }
  // Lang keys are lowercase ISO 639-1; empty / missing langs are skipped.
  careInstructionsByLang   Json     @default("{}")
  // Languages this ProdSpec's outputs render, as an array of lowercase
  // language codes (e.g. ["en","da","de"]). Toggled per ProdSpec in the
  // editor and the /prod-specs/languages matrix. Empty array ⇒ templates
  // fall back to their built-in default language set (backward compatible).
  outputLanguages          Json     @default("[]")
  // Overrides Customer-level column mapping if present; otherwise inherits.
  columnMapping            Json     @default("{}")
  // [{ id: "monday_column_id", label: "Composition" }, ...]
  requiredFields           Json     @default("[]")
  autoGenerateThresholdPct Int      @default(100)
  // Defaults to false so auto-created scaffolds (Style ingest, /import
  // Accept) land in "needs configuration" until an admin reviews them.
  // The PATCH endpoint auto-activates on any non-active field change.
  // Inactive ProdSpecs are excluded from Job auto-enqueue — a Style at
  // 100% completion still stays PENDING until its ProdSpec is active.
  active                   Boolean  @default(false)
  // Admin "Fully approved" toggle — OFF by default and INDEPENDENT of `active`
  // (a spec can be active but not fully approved). When true, this spec is
  // cleared for spec-wide auto-approval of its outputs (that runner wiring is a
  // separate workstream). NB: distinct from the per-STYLE computed
  // `fullyApproved` coverage flag in lib/outputs/current-outputs.ts.
  fullyApproved            Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessArea BusinessArea       @relation(fields: [businessAreaId], references: [id], onDelete: Restrict)
  suppliers    ProdSpecSupplier[]
  styles       Style[]
  jobs         Job[]
  images       ProdSpecImage[]

  @@unique([customerId, businessAreaId])
  @@index([customerId])
  @@index([businessAreaId])
  @@map("prod_specs")
}

// Images uploaded for the "General information" page. Bytes live in Postgres
// — same pattern as JobAsset.pdf — so they travel with the DB and need no
// external storage. The general-info markdown (ProdSpec.generalInfoMd)
// references each image by a short serve URL
// (/api/admin/prod-specs/<id>/images/<imageId>): the browser editor + preview
// resolve that path directly, and the PDF renderer inlines it to a data URL at
// render time (page.setContent has no base URL, so a bare path won't load).
// See src/lib/pdf/inline-images.ts.
model ProdSpecImage {
  id         String   @id @default(cuid())
  prodSpecId String
  // Raw image bytes (PNG/JPEG/WebP/GIF/SVG), decoded from the upload's data
  // URL; re-emitted as a data URL only at PDF render time.
  data       Bytes
  mimeType   String
  fileName   String
  byteSize   Int
  createdAt  DateTime @default(now())

  prodSpec ProdSpec @relation(fields: [prodSpecId], references: [id], onDelete: Cascade)

  @@index([prodSpecId])
  @@map("prod_spec_images")
}

model ProdSpecSupplier {
  id         String   @id @default(cuid())
  prodSpecId String
  supplierId String
  createdAt  DateTime @default(now())

  prodSpec ProdSpec @relation(fields: [prodSpecId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([prodSpecId, supplierId])
  @@index([supplierId])
  @@map("prod_spec_suppliers")
}

model Template {
  id           String   @id @default(cuid())
  customerId   String
  docType      String
  businessArea String?
  layout       Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, docType, businessArea])
  @@index([customerId])
  @@map("templates")
}

// =====================================================
// OutputLayout — an operator-built print layout from the Output Builder
// (/output-builder). The `definition` JSON is the whole artifact: pages
// with mm dimensions, corner-anchored text blocks, {{token}} variables.
// Validated by LayoutDefSchema (src/lib/output-layouts/schema.ts) on
// every write; rendered by renderLayoutHtml at preview AND job time.
//
// PUBLISHED layouts register as template variants under the key
// `layout:<id>` — they appear in the ProdSpec output picker but only
// generate once an operator explicitly adds them to a ProdSpec's
// outputs (no auto-attach). customerId/businessAreaId are the builder's
// default TEST-DATA binding, not a usage restriction.
// =====================================================
model OutputLayout {
  id             String             @id @default(cuid())
  name           String
  // JobAsset.docType for assets generated from this layout, and the
  // grouping bucket in the output pickers.
  docType        String            @default("STICKER")
  definition     Json               @default("{}")
  status         OutputLayoutStatus @default(DRAFT)
  // Bumped on every publish — JobAsset displayNames carry the version so
  // an asset can be traced to the layout revision that produced it.
  version        Int                @default(0)
  // When true, assets generated from this layout skip the manual per-asset
  // review queue — the runner marks them APPROVED at generation, BUT only
  // when print-safe (placeholderCount == 0); a doc with placeholder
  // artifacts always falls back to manual review. Delivery to the supplier
  // still requires the explicit job-level "Approve all & publish" action —
  // auto-approve removes the review click, not the human send checkpoint.
  autoApprove    Boolean            @default(false)
  // Marks this layout as an "info area" — a direct-print packaging block
  // whose physical print size is switchable PER STYLE (admin InfoAreaSize
  // or a one-time custom size, stored on ProdSpecOutput.infoAreaSizeId).
  // When set, the renderer overrides the layout's page dimensions with the
  // chosen size; see effectiveOutputDims in src/lib/prod-spec/info-area.ts
  // and renderLayoutHtml's sizeOverrideMm option.
  isInfoArea     Boolean            @default(false)
  // Per-layout logo for the {{logo:custom}} token (data URL — SVG/PNG/JPEG),
  // uploaded in the Output Builder. Replaces the old global custom logo so
  // each layout carries its own. The print width is set as a % of the block
  // (LayoutSettings.customLogoWidthPct); height auto-scales. Null = none.
  customLogo     String?
  customerId     String?
  businessAreaId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessArea BusinessArea? @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([customerId])
  @@map("output_layouts")
}

enum OutputLayoutStatus {
  DRAFT
  PUBLISHED
}

// UI-managed doc-type catalogue (Custom outputs → Document types card).
// Replaces the old DocType Postgres enum so operators can add types
// without a migration. `value` is the immutable SCREAMING_SNAKE storage
// key written to OutputLayout/JobAsset/Template.docType; `label` is the
// display name, freely editable. The runner-internal COVER/GENERAL_INFO
// framing pages are deliberately NOT rows here — they aren't pickable
// (see src/lib/pdf/bundle-pages.ts); docTypeLabel() prettifies them.
model DocTypeDef {
  value     String   @id
  label     String
  sortOrder Int      @default(0)
  // Keyword exclusion rules: skip generating EVERY output of this type for a
  // style when one matches. JSON array of
  //   { field: <synced ColumnMapping key>, op: "contains"|"equals", keywords: string[] }
  // e.g. Wash care → [{ field: "productGroup", op: "contains", keywords: ["shoes","sock"] }]
  // means a sock/shoe style generates no wash-care outputs (and the review
  // surfaces WHY). Additive with a default so reads degrade to "no rules"
  // until db:deploy. See src/lib/outputs/exclusion.ts.
  exclusionRules Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("doc_types")
}

// =====================================================
// App settings — global, app-wide configuration as a small key-value
// store. One row per setting key; `value` holds JSON so new global flags
// can be added without a migration. Today it backs the "auto-generate
// outputs" master switch (key: "autoGenerateEnabled"), read by the
// auto-enqueue paths (Monday style webhook, import promotion).
// =====================================================
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Images referenced by the GLOBAL cover-page content block (AppSetting
// "coverPageInfoMd"). Global counterpart of ProdSpecImage — the block is
// app-wide, not owned by any one ProdSpec — so the bytes live in their own
// table with no owner FK. Same storage model: raw bytes in Postgres, referenced
// from the markdown by a short serve URL, re-emitted as a data URL only at PDF
// render time (src/lib/pdf/inline-cover-images.ts).
model CoverPageImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  fileName  String
  byteSize  Int
  createdAt DateTime @default(now())

  @@map("cover_page_images")
}

model Style {
  id                  String         @id @default(cuid())
  customerId          String
  // FKs resolved from the local Monday mirrors during ingest. Nullable
  // because the linked rows may not exist yet (mirrors not yet synced).
  businessAreaId      String?
  supplierId          String?
  prodSpecId          String?
  // Optional link to a QR image from the QrImage library, rendered on
  // care-label-02 page 4. SetNull on delete so retiring a QR image
  // doesn't cascade-delete styles.
  qrImageId           String?
  mondayItemId        String         @unique
  mondayBoardId       String
  name                String
  // Free-text fallback retained so legacy data and the manual entry form
  // keep working until BusinessArea mirror is populated.
  businessArea        String?
  // PO Number — visibility filter, NOT a gating trigger. Rows without one
  // are still synced but hidden from the print queue by default.
  poNumber            String?
  styleFolderUrl      String?
  // The style's "<style> – <customer>" subfolder in the SUPPLIER's own
  // SharePoint folder (Contrast-Suppliers), captured on the first successful
  // push. Distinct from styleFolderUrl (the Monday style-folder with source
  // files). The nightly digest links this so suppliers land directly on
  // their files; null until something has been pushed.
  supplierFolderUrl   String?
  // Operator-chosen PO folder NAME, when the supplier's SharePoint has several
  // folders matching this style's PO (AMBIGUOUS). Employees create PO folders
  // manually and can end up with duplicates; rather than the app guessing or
  // deleting, a user picks one here and the push/verify send to exactly that
  // folder (resolvePoFolder honours it). Null = auto-resolve (0/1/many). A
  // stored name no longer present in the supplier folder falls back to
  // auto-resolve, so a deleted/renamed choice safely re-flags.
  supplierPoFolderName String?
  // Monday group this item lives in (e.g. "✅ Done", "⏰ Behind
  // Schedule", "Cancelled"). Captured from MondayItem.group on every
  // ingest so list views / scans can default-hide archived items
  // without re-syncing. groupId stays stable across Monday-side title
  // changes; groupTitle is the editable label operators see.
  groupId             String?
  groupTitle          String?
  rawData             Json           @default("{}")
  completionPct       Int            @default(0)
  missingFields       Json           @default("[]")
  status              StyleStatus    @default(PENDING)
  // -------- PO → EAN resolution (scraped from the Purchase Order PDF) --------
  // eanStatus is BOTH the durable state and the queue: rows land in PENDING
  // when a PO number is filled (Monday ingest), the EAN runner
  // (/api/po-eans/run) drains them, and PO_FOUND_NO_EANS marks "we have the
  // PO but the PDF has no barcode/EAN page yet" — retried by the sweep so it
  // resolves automatically once the supplier adds barcodes.
  eanStatus           StyleEanStatus @default(NONE)
  // Carton / assortment-level EAN from the PO (single value, not per-size).
  cartonEan           String?
  // Colour-source override for repeat-per-EAN rendering. Repeat-per-EAN
  // normally binds each row's {{colourName}} to the colour PARSED FROM THE PO
  // variant label — because a multi-colourway pack (2-pack A+B) has one PO EAN
  // row per (size × colour), whereas the Style board carries a single colour
  // and would silently collapse the pack to one colourway. When an operator
  // knows the PO label colour is wrong/messy for a given style, this flag flips
  // that one style back to the Style board colour ({{colourCode}}'s name) for
  // per-EAN rows too. Default false = PO colour (the historical behaviour); the
  // colour CODE always comes from the board regardless. Consumed in
  // output-layouts/render.ts (repetitionStyles, repeatBy="ean").
  useStyleBoardColour Boolean        @default(false)
  // Which PO PDF we matched, for audit/debug.
  poFileName          String?
  // When the last resolution attempt landed (success OR terminal failure).
  // The retry sweep compares this against its cutoff to re-queue stuck rows.
  eanResolvedAt       DateTime?
  // Set when a worker claims the row (PENDING→RESOLVING); used for stale
  // recovery, mirrors Job.startedAt.
  eanResolveStartedAt DateTime?
  // Consecutive non-resolved scrape attempts. Reset to 0 on RESOLVED/PARTIAL;
  // incremented on every error / not-found / no-barcode outcome. Once it hits
  // MAX_EAN_ATTEMPTS (see src/lib/po/ean-status-meta.ts) the retry sweep stops
  // re-queuing the row and it "floats" on /po-eans for a human to re-trigger.
  eanAttempts         Int            @default(0)
  // When this style's PO landed (newly filled or changed at ingest) — a STABLE
  // "PO queued at" stamp, NOT bumped by unrelated re-syncs. The automation
  // recent-window uses it: only PENDING rows whose eanQueuedAt is within the
  // window auto-scrape, so the historical backlog (older / null) is parked and
  // a bulk re-sync can't drag it back in. Backfilled to createdAt for existing
  // rows. Null = never had a PO queued.
  eanQueuedAt         DateTime?
  // Fingerprint of the inputs the last EAN scrape resolved against (PO number,
  // style number, Customer Item No, Colour code, size run — see
  // src/lib/po/resolve-inputs.ts). Recomputed before each render: if it no
  // longer matches the current Monday snapshot, a Sizes / Colour-code edit has
  // landed since the scrape (which — unlike a PO change — does NOT re-queue a
  // resolve at ingest), so the style_eans snapshot is stale and the runner
  // re-resolves before building the PDFs. Null = never resolved / pre-feature
  // row (the runner backfills it on the next render without a forced re-scrape).
  eanResolveKey       String?
  // Trimmed snapshot of the LAST PO scrape's per-section dump — the shape in
  // src/lib/po/scrape-snapshot.ts (every section the Barcodes page carried,
  // each variant label + EAN, and whether this style's resolve used it).
  // Previously this lived only in EanDiagnostics.poSections, which was built
  // on every scrape and then explicitly dropped before the Log write, so the
  // answer to "what did this PO actually contain?" survived a few hundred ms
  // inside the runner and was gone by the time anyone opened the style. Now
  // it is persisted so the scrape panel — and the style explainer — can answer
  // that on page load instead of forcing a re-scrape of SharePoint. Trimmed
  // (no text snippet, capped sections/variants) to keep the row small.
  // Null = never scraped, or scraped before this field existed.
  poScrapeSnapshot    Json?
  // Numeric value of the PO reference (last digit run of poNumber, e.g. 63144
  // for "C-PO63144") — see parsePoNumberValue in src/lib/po/po-number.ts. The
  // automation cutoff uses it: auto-scrape + the generation sweep only touch
  // styles whose poSeq >= the configured minimum PO, so orders before the
  // cutoff are parked. Set at ingest whenever poNumber is written; null when
  // there's no PO / no digits.
  poSeq               Int?
  // Manually "pulled into the styleboard" for layout testing (Settings ▸ Pull
  // style by PO). When set, the style stays visible on /styles regardless of
  // its Monday group — overriding the Templates/Done hide in activeStylesWhere
  // — so an operator can pull a historical PO in to test every output layout.
  // Null = not pulled (normal visibility rules apply). Cleared by "un-pull".
  pulledForTestAt     DateTime?
  lastSyncedAt        DateTime?
  // Soft lifecycle from Monday. We never hard-delete a Style: an
  // item_archived / item_deleted webhook stamps these instead, so the row
  // (and its full Log trail) survives for audit while the UI hides it.
  archivedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  businessAreaRef  BusinessArea?     @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  prodSpec         ProdSpec?         @relation(fields: [prodSpecId], references: [id], onDelete: SetNull)
  qrImage          QrImage?          @relation(fields: [qrImageId], references: [id], onDelete: SetNull)
  jobs             Job[]
  eans             StyleEan[]
  rejectionTickets RejectionTicket[]
  supplierShare    SupplierShare?
  views            StyleView[]

  @@index([customerId])
  @@index([status])
  @@index([businessAreaId])
  @@index([supplierId])
  @@index([prodSpecId])
  @@index([qrImageId])
  @@index([poNumber])
  // Lookalike detection: the "same style name, different PO" query behind the
  // related-rows card / list chip. Monday can carry the SAME style name on
  // several Pre-Order rows (one per PO), which is the single biggest source of
  // "this style looks wrong" reports — a reviewer opens the wrong row. Indexed
  // so that lookup is cheap enough to run on every list render.
  @@index([name])
  @@index([groupTitle])
  @@index([eanStatus])
  // Windowed EAN claim/sweep filters PENDING by eanQueuedAt.
  @@index([eanStatus, eanQueuedAt])
  // Automation PO cutoff filters PENDING by poSeq.
  @@index([eanStatus, poSeq])
  @@index([archivedAt])
  @@index([deletedAt])
  // Pulled-for-test styles are surfaced regardless of group — small set, looked
  // up directly in activeStylesWhere and the Settings management list.
  @@index([pulledForTestAt])
  @@map("styles")
}

enum StyleStatus {
  PENDING
  READY
  GENERATING
  AWAITING_REVIEW
  APPROVED
  REJECTED
}

// Per-size EAN resolved from a Style's Purchase Order PDF. One row per size
// in the style's size run, kept in `position` order, written by the EAN
// runner (src/lib/po/ean-runner.ts). `ean13` is null when that size has no
// matching barcode in the PO. The carton/assortment EAN is a single value
// and lives on Style.cartonEan, not here.
model StyleEan {
  id           String   @id @default(cuid())
  styleId      String
  // 0-based index into the style's size run — preserves print order.
  position     Int
  // Size label as it appears on the style (e.g. "M", "ONE SIZE").
  size         String
  // 13-digit EAN, or null when no PO variant matched this size.
  ean13        String?
  // Carton/assortment EAN of the PO SECTION this row came from. A multi-
  // colourway style lists each colour as its own PO section with its own
  // carton, so the carton is per-(size×colour) row, not one per style. The
  // single Style.cartonEan stays as a representative for non-repeating outputs.
  cartonEan    String?
  // The PO variant label we matched this size against (audit).
  variantLabel String?
  // Manual override (style-page EAN panel). `excluded` hides a row from all
  // rendering/tokens without deleting it — the operator's escape hatch when the
  // scrape over-includes; it survives re-resolve (carried by size+ean13).
  // `manual` marks a hand-added row (not from any scrape), which re-resolve
  // always preserves.
  excluded     Boolean  @default(false)
  manual       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, position])
  @@index([styleId])
  @@map("style_eans")
}

enum StyleEanStatus {
  // No PO number yet, or EAN resolution doesn't apply.
  NONE
  // PO number is set → queued for the EAN runner to resolve.
  PENDING
  // Claimed by a worker pass (PENDING→RESOLVING); stale rows recover to PENDING.
  RESOLVING
  // Every size in the run has an EAN.
  RESOLVED
  // The PO scrape failed and the retry budget was spent, so the EANs were
  // read from the Pre-Order "Barcode Number" / "Carton Barcode number 1" text
  // columns instead (src/lib/po/monday-barcode-fallback.ts). Terminal-good —
  // treated like RESOLVED for generation, but badged distinctly so it's clear
  // the codes came from Monday, not the PO.
  RESOLVED_FROM_MONDAY
  // Some sizes have EANs, some don't — or the PO had extra unmatched variants.
  PARTIAL
  // PO PDF was found and downloaded, but it has no barcode/EAN page yet.
  // This is the "have PO, no EANs" flag; the sweep retries these.
  PO_FOUND_NO_EANS
  // No PO PDF could be located in the SharePoint Suppliers library.
  PO_NOT_FOUND
  // PO PDF was found and parsed and it DOES carry barcodes — but none of its
  // style sections matches this style's style number. We refuse to guess: a
  // multi-style PO would otherwise leak a different style's EANs, so the
  // resolve is rejected and surfaced for manual attention. The sweep retries
  // these (a re-issued PO may add the style later) until the float cap.
  STYLE_NOT_IN_PO
  // SharePoint / download / parse failure.
  ERROR
}

model Job {
  id            String        @id @default(cuid())
  styleId       String
  // Snapshot of the resolved ProdSpec at enqueue time. Nullable because
  // legacy rows and Styles without a resolved (Customer × BA) pair have
  // no ProdSpec. Used for analytics — `count(jobs) group by prodSpecId`
  // gives us "how often is each ProdSpec generating PDFs".
  //
  // SetNull on delete: removing a ProdSpec mustn't cascade out the
  // historical Job rows — they still document what happened.
  prodSpecId    String?
  status        JobStatus     @default(QUEUED)
  triggerSource TriggerSource
  documentTypes Json          @default("[]")
  // Output variant keys this job should render (per-output generation).
  // Empty array ⇒ "all enabled outputs" (manual full-regen / legacy rows).
  // Non-empty ⇒ the runner renders exactly this subset, re-checking each
  // output's readiness at run time. See src/lib/queue/runner.ts.
  variantKeys   Json          @default("[]")
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Test-phase review machinery (see lib/review-flow/flags.ts): the user
  // who pressed "Start review" on the review screen — or made the first
  // decision — and thereby owns seeing this review through. Drives the
  // leave guard + My tasks attribution. Re-runs reset it naturally (each
  // run is a new Job row). SetNull keeps historical jobs if a user goes.
  reviewClaimedById String?
  reviewClaimedAt   DateTime?
  // When this review finished — the moment the job left AWAITING_REVIEW
  // (all assets approved → published, or any rejected → rolled up). Paired
  // with reviewClaimedAt it gives a review's start→end span for super-admin
  // reporting (/settings/review-activity). DEFINED here, but the WRITE lives
  // at the settle seam in the approval track (maybeSettleJob /
  // publishApprovedJob) — kept out of this track to avoid colliding there.
  // Read-only until that write lands; reports tolerate a still-null value.
  reviewEndedAt     DateTime?

  style            Style             @relation(fields: [styleId], references: [id], onDelete: Cascade)
  prodSpec         ProdSpec?         @relation(fields: [prodSpecId], references: [id], onDelete: SetNull)
  reviewClaimedBy  User?             @relation("ReviewClaimer", fields: [reviewClaimedById], references: [id], onDelete: SetNull)
  logs             Log[]
  reviewActions    ReviewAction[]
  assets           JobAsset[]
  rejectionTickets RejectionTicket[]

  @@index([status])
  @@index([styleId])
  @@index([prodSpecId])
  @@index([reviewClaimedById])
  @@map("jobs")
}

model JobAsset {
  id               String            @id @default(cuid())
  jobId            String
  docType          String
  // Template variant that produced this asset. References a key in
  // src/lib/pdf/template-registry.ts. Multiple assets per job can share
  // a docType but each variantKey is unique within a job.
  variantKey       String?
  fileName         String
  // Human-readable label for the "Delivered Prod Specs" list. Set from
  // the variant's `name` at render time; falls back to the docType label.
  displayName      String?
  pdf              Bytes
  // Placeholder artifacts (dashed missing-artwork tiles, "No carton EAN
  // configured" boxes) counted in the rendered HTML at generation time.
  // > 0 means the PDF is review-safe but NOT print-safe — approval is
  // blocked until the gaps are fixed and the output is re-run.
  placeholderCount Int               @default(0)
  // Fingerprint of the OUTPUT's render-affecting config at the moment this
  // asset was built (outputConfigKey: dims / pins / carton barcode / info-area
  // size). The rerun surfaces recompute the key from the current spec and
  // compare: a mismatch on a still-awaiting-review output means the admin
  // edited the output since it rendered, so it's "changed" and re-runnable.
  // Nullable: legacy rows (and rows built before this shipped) carry null,
  // which the detectors treat as "unknown → not changed" until re-rendered or
  // backfilled (scripts/backfill-output-config-key.ts).
  outputConfigKey  String?
  // Published version of the Output Builder layout this asset rendered from
  // (OutputLayout.version, bumped on every publish). The rerun surfaces compare
  // it to the layout's CURRENT version: a bump on a still-awaiting-review output
  // means the layout content was re-published since it rendered, so it's
  // "changed" too. Null for coded variants and legacy rows — a null on either
  // side is skipped (no false "changed"), so this needs no backfill.
  outputContentVersion Int?
  // Per-asset review state — separate from the parent Job's status so
  // we can approve some outputs and reject others with reasons.
  reviewStatus     AssetReviewStatus @default(PENDING_REVIEW)
  rejectReason     String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime          @default(now())

  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedBy       User?             @relation("AssetReviewer", fields: [reviewedById], references: [id])
  rejectionTickets RejectionTicket[]

  @@unique([jobId, variantKey])
  @@index([jobId])
  @@index([reviewStatus, docType])
  // Style Dashboard counts assets generated per 1h/24h/7d window by createdAt.
  @@index([createdAt])
  @@map("job_assets")
}

enum AssetReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum JobStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum TriggerSource {
  WEBHOOK
  MANUAL_RERUN
  ADMIN_TEST
  // Job enqueued by the /import flow when a ghost item is promoted to a
  // Style row (Manual Import bulk action, or one-click Accept on a new
  // (Customer × BusinessArea) combination). Kept distinct from WEBHOOK
  // so dashboards can tell "promoted by an operator" apart from "ingest
  // fired by Monday".
  MANUAL_IMPORT
  // Silent iteration re-run from a RejectionTicket ("Re-run output" on
  // /settings/rejection-log). The runner suppresses the generic
  // review-ready email for these — the admin is testing a fix and the
  // reviewer must not be pinged on every attempt.
  TICKET_RERUN
  // Final re-run fired by "Mark fixed & notify" on a RejectionTicket.
  // Generic review-ready email suppressed too — the fix endpoint sends
  // the dedicated TICKET_FIXED email itself after the run succeeds.
  TICKET_FIX
  // Job enqueued by the PO→EAN resolve handoff: when a scrape lands the
  // barcodes a style's outputs were waiting on, its now-ready outputs auto-
  // fire (same gate as WEBHOOK). See enqueueReadyOutputsAfterResolve in
  // src/lib/po/ean-runner.ts. Kept distinct so dashboards can tell
  // "generated because barcodes landed" apart from a Monday sync.
  EAN_RESOLVED
  // Job enqueued by the periodic backlog sweep (/api/jobs/run?sweep=1, driven
  // by the Railway cron): pulls every active style with ready, ungenerated
  // outputs through generation, gradually. Email-suppressed like EAN_RESOLVED.
  CRON_SWEEP
  // Job enqueued by the admin "Run all outputs" bulk action on /styles — one
  // job per style in the operator's current filtered table view, tracked by a
  // BulkRunBatch. Email-suppressed (a 200-style run mustn't blast 200 review
  // emails); reviewers still get the in-app inbox entry per style.
  MANUAL_BULK
}

model Log {
  id        String   @id @default(cuid())
  jobId     String?
  level     LogLevel @default(INFO)
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("logs")
}

// One row per automation tick that did (or skipped) work. The EAN runner and
// the generation runner each write one when invoked by the Railway cron
// (?sweep=1) or a signed-in "Run now" — powering the /automation activity page
// so operators can see what the cron actually did. High-frequency inline
// webhook triggers are NOT recorded (only sweep / session calls) to keep it
// readable.
model CronRun {
  id   String @id @default(cuid())
  // "po-eans" = EAN scrape drain · "jobs" = generation enqueue + render.
  kind String
  // "secret" = automation (cron) · "session" = a signed-in operator.
  source String
  // True when the call no-op'd because its master switch was off.
  skipped    Boolean  @default(false)
  note       String?
  processed  Int      @default(0)
  failed     Int      @default(0)
  // EAN runner: rows re-queued by the sweep.
  requeued   Int      @default(0)
  // Generation runner: jobs enqueued by the backlog sweep.
  enqueued   Int      @default(0)
  styleIds   Json     @default("[]")
  jobIds     Json     @default("[]")
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("cron_runs")
}

// One row per admin "Run all outputs" bulk action on /styles. The button
// enqueues a MANUAL_BULK generation job per style in the operator's current
// filtered table view; this row is the progress handle the page polls
// (DONE/TOTAL) so the run survives navigating away and back. Mirrors the
// SyncJob progress model the Fill flow already polls.
//
// Job linkage is denormalized as jobIds[] (same pattern as CronRun) rather
// than a Job.batchId column — keeps this purely additive, so existing Job
// reads never hit a not-yet-deployed column (the ColumnNotFound trap).
model BulkRunBatch {
  id String @id @default(cuid())
  // Who pressed the button. Denormalized email so "Started by …" needs no
  // join and survives the user being deleted; id kept for attribution.
  createdById    String?
  createdByEmail String?
  // Human description of the filter that produced this batch, e.g.
  // "Customer: Netto · Status: Ready to generate · 42 styles". Shown in the
  // progress widget so a returning admin recognizes which run this is.
  label String
  // Stable denominator: jobs actually enqueued at creation. DONE is counted
  // live over jobIds at poll time; TOTAL stays put even if a job row is later
  // pruned (e.g. its style is deleted), so the bar can't exceed 100%.
  total      Int       @default(0)
  styleIds   Json      @default("[]")
  jobIds     Json      @default("[]")
  createdAt  DateTime  @default(now())
  // Stamped the first time a poll finds nothing left in flight (all jobs left
  // QUEUED/RUNNING). Drives the "complete" state + the recency window.
  finishedAt DateTime?

  @@index([createdAt])
  @@map("bulk_run_batches")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model ReviewAction {
  id        String           @id @default(cuid())
  jobId     String
  userId    String
  action    ReviewActionType
  reason    String?
  createdAt DateTime         @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@map("review_actions")
}

enum ReviewActionType {
  APPROVED
  REJECTED
}

// =====================================================
// Rejection tickets — the admin work-log behind /settings/rejection-log.
// One ticket per rejected output (per style × variantKey thread): created
// when a reviewer rejects an output with a comment, worked by an admin
// (silent re-runs), marked fixed (re-notifies the reviewer), and resolved
// when the re-generated output is approved.
// =====================================================

enum RejectionTicketStatus {
  OPEN // created by a reviewer rejection (or reopened by a re-rejection)
  IN_PROGRESS // admin pressed "Start work"
  FIXED // admin pressed "Mark fixed & notify" — awaiting re-review
  RESOLVED // the re-generated output was approved by the reviewer
}

model RejectionTicket {
  id     String                @id @default(cuid())
  status RejectionTicketStatus @default(OPEN)

  // Live refs. jobId/jobAssetId are SetNull because the runner DELETES all
  // JobAssets on every re-run — the ticket must outlive the asset it was
  // raised against. styleId cascades: no style, no meaningful ticket.
  styleId    String
  jobId      String?
  jobAssetId String?

  // Snapshots at rejection time — keep the log readable forever, even
  // after re-runs replace assets or the style is renamed on Monday.
  // variantKey may be "" for legacy assets that predate per-variant keys
  // (ticket re-runs then regenerate the full job instead of one output).
  variantKey   String
  docType      String
  outputName   String // JobAsset.displayName, e.g. "Carton marking · 150×75 mm"
  fileName     String
  customerName String
  businessArea String?
  poNumber     String?
  styleName    String
  styleNumber  String // Style.mondayItemId

  // The reviewer's rejection comment. Re-rejections after FIXED reopen the
  // same ticket and append here (separator + timestamp) instead of
  // creating a duplicate thread.
  comment       String
  reportedById  String
  reopenedCount Int    @default(0)

  startedAt  DateTime? // → IN_PROGRESS
  fixedAt    DateTime? // → FIXED
  resolvedAt DateTime? // → RESOLVED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  style       Style                 @relation(fields: [styleId], references: [id], onDelete: Cascade)
  job         Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobAsset    JobAsset?             @relation(fields: [jobAssetId], references: [id], onDelete: SetNull)
  reportedBy  User                  @relation("TicketReporter", fields: [reportedById], references: [id])
  // Image(s) the reviewer attached to the comment (screenshots / photos).
  attachments RejectionAttachment[]

  @@index([status, createdAt])
  // Auto-resolve lookup: approving an output resolves the open ticket for
  // the same (style, variantKey) thread.
  @@index([styleId, variantKey])
  @@map("rejection_tickets")
}

// Image a reviewer attached to a rejection comment (a screenshot/photo of
// what's wrong). Bytes live in Postgres — same pattern as prod_spec_images
// and job_assets.pdf — resized client-side before upload, served back only
// behind the admin rejection log. Cascade-deleted with the ticket thread.
model RejectionAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  data         Bytes
  mimeType     String
  fileName     String
  byteSize     Int
  uploadedById String? // who attached it (audit) — scalar, no back-relation
  createdAt    DateTime @default(now())

  ticket RejectionTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("rejection_attachments")
}

// =====================================================
// Email log — every outbound email attempt, real or simulated. Written by
// src/lib/email/dispatch.ts. Powers the simulation popups (the UI shows
// exactly what WOULD have been sent while RESEND_EMAILS is off) and the
// activity table on /settings/notifications.
// =====================================================

enum EmailType {
  REVIEW_READY // job generated → internal reviewer
  TICKET_FIXED // rejection ticket marked fixed → internal reviewer
  SUPPLIER_APPROVAL // job fully approved → supplier
  SUPPLIER_MESSAGE // admin-written follow-up to a past send batch → supplier
  INVITE // signup invitation link → invitee
  NEW_COMBO // new (customer × business area) combo detected → admin heads-up
  PASSWORD_RESET // password reset link → the account holder (self-service or admin-sent)
}

enum EmailStatus {
  SENT // Resend accepted it (id in providerId)
  SIMULATED // RESEND_EMAILS off → recorded + surfaced instead of sending
  SKIPPED // flag on but Resend unconfigured, or no recipient resolvable
  FAILED // Resend errored (message in error)
}

model EmailLog {
  id          String      @id @default(cuid())
  type        EmailType
  status      EmailStatus
  to          String // comma list as resolved ("" when no recipient → SKIPPED)
  cc          String?
  subject     String
  // Body snapshot — small (a few KB). Attachment BYTES are never stored
  // here; the PDFs already live in job_assets. attachments is
  // [{ filename, bytes }] metadata only.
  html        String
  text        String?
  attachments Json        @default("[]")
  providerId  String?
  error       String?
  // Loose refs (no FK) — the activity log must outlive jobs/styles/tickets.
  jobId       String?
  styleId     String?
  ticketId    String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([jobId])
  @@map("email_logs")
}

// Resend delivery events (delivered / opened / clicked / bounced) for sent
// emails, captured via the Resend webhook. Matched to EmailLog by providerId
// (the Resend message id). Loose refs like EmailLog so it outlives jobs.
model EmailEvent {
  id         String   @id @default(cuid())
  providerId String // Resend message id — matches EmailLog.providerId
  emailLogId String? // resolved at ingest when the EmailLog is found
  type       String // delivered | opened | clicked | bounced | complained | ...
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([emailLogId])
  @@map("email_events")
}

// =====================================================
// Supplier share — the per-approval, supplier-facing link. Created when a
// job is published (approved); the supplier email carries its URL (/s/<token>)
// plus a 4-digit PIN. The supplier unlocks the page with their email + PIN
// to view the approved PDFs. "Visited" = a successful unlock — surfaced on
// the Style's prod-spec tab so the team can see whether the supplier opened
// it. One share per published job (jobId unique); a correction re-publish
// creates a fresh share (new token + PIN).
// =====================================================
model SupplierShare {
  id      String @id @default(cuid())
  // Unguessable URL secret — the primary gate. /s/<token>.
  token   String @unique
  // 4-digit PIN, the second factor. Carried in the approval email and shown
  // to the team on the prod-spec tab so they can re-send it. Plaintext on
  // purpose (low-sensitivity, admin-visible); the token is the real secret.
  pin     String
  // Address the link is gated to (the supplier email the latest approval
  // went to). The unlock form checks the typed email against this,
  // case-insensitively.
  email   String
  // ONE durable share per style — the token + PIN stay stable across
  // approvals. The portal always serves the style's LATEST APPROVED version
  // of each output, so re-approving a correction "pushes through" to the
  // same link without re-issuing it. (Earlier this was a per-job snapshot.)
  styleId String @unique

  // Visit tracking — a "visit" is a SUCCESSFUL unlock (email + PIN correct).
  // Cumulative across approvals (durable link, not reset on re-approve).
  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?
  visitCount     Int       @default(0)
  // Wrong-PIN attempts; the unlock endpoint blocks once this gets high
  // (defence-in-depth behind the unguessable token). Reset on success.
  failedAttempts Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@map("supplier_shares")
}

// =====================================================
// Style view log — append-only audit trail of who opened a style and when.
// One row per page open: surface = REVIEW (the /styles/<id>/review screen) or
// STYLE (the /styles/<id> detail page). Distinct from Job.reviewClaimedAt
// (which records who OWNS a review, once), this captures EVERY visit so the
// admin oversight panel (/admin) can show a full chronological view log.
// Written best-effort by a one-shot client beacon; reads tolerate the table
// not being deployed yet (see /admin).
// =====================================================
model StyleView {
  id        String           @id @default(cuid())
  styleId   String
  userId    String
  surface   StyleViewSurface
  createdAt DateTime         @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([styleId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("style_views")
}

enum StyleViewSurface {
  REVIEW // the /styles/<id>/review screen
  STYLE // the /styles/<id> detail page
}

// =====================================================
// User presence — one row per user, refreshed by a client heartbeat (every
// ~60s while any admin page tab is open; see PresencePing in the admin layout).
// `lastSeenAt` is the single source for "online now" (seen within the window),
// "last online", and the online count on the /admin Users tab. One row per user
// (userId is the PK), upserted on each ping. Standalone table (no column on the
// hot `users` row) so existing user reads never change; reads tolerate the table
// not being deployed yet (see /admin Users tab).
// =====================================================
model UserPresence {
  userId     String   @id
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
  @@map("user_presence")
}

// =====================================================
// Per-user notifications — the /dashboard feed. Event-shaped messages
// addressed to ONE user: in-app mirrors of the REVIEW_READY and
// TICKET_FIXED emails first, anything user-addressed later. The dashboard's
// "unfinished review" rows are NOT stored here — those are derived live
// from Job/JobAsset state (lib/dashboard/review-tasks.ts), which is strictly
// more reliable than event rows (a killed tab can't POST an event).
// resolvedAt is stamped by the job settle paths so a stale "go review this"
// row can't outlive the work it points at.
// =====================================================

enum UserNotificationType {
  REVIEW_READY // documents rendered → go review (mirror of the email)
  TICKET_FIXED // your rejection was fixed → re-review (mirror of the email)
  GENERIC // future: anything addressed to a single user
}

model UserNotification {
  id    String               @id @default(cuid())
  userId String
  type  UserNotificationType
  title String
  body  String?
  // In-app destination, e.g. /styles/<id>/review. Snapshot — kept even if
  // the target is later deleted (the row just stops being clickable).
  href  String?
  // Loose refs (no FK) — the feed must outlive jobs/styles/tickets, same
  // policy as EmailLog. jobId powers the settle-time auto-resolve.
  jobId    String?
  styleId  String?
  ticketId String?

  createdAt   DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissedAt, resolvedAt, createdAt])
  @@index([jobId])
  @@map("user_notifications")
}

// Track Monday webhook subscriptions we own.
// IMPORTANT: this table is append/refresh-only. We never call Monday's
// delete-webhook endpoint from code (see global rule in CLAUDE.md).
model MondayWebhook {
  id              String   @id @default(cuid())
  mondayWebhookId String   @unique
  boardId         String
  eventType       String
  url             String
  createdAt       DateTime @default(now())

  @@unique([boardId, eventType])
  @@index([boardId])
  @@map("monday_webhooks")
}

// Shared Monday column mapping — the SAME columns are synced for every
// customer, so the mapping + required fields live in a single global row
// rather than being duplicated per customer. Singleton: id is always "global".
model MondayColumnConfig {
  id             String   @id @default("global")
  columnMapping  Json     @default("{}")
  requiredFields Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monday_column_config")
}

// Audit trail for bulk Monday → local mirror syncs. One row per sync run.
model SyncJob {
  id           String     @id @default(cuid())
  kind         SyncKind
  status       SyncStatus @default(RUNNING)
  itemsTotal   Int        @default(0)
  itemsSynced  Int        @default(0)
  itemsFailed  Int        @default(0)
  // Items that didn't error but couldn't be auto-classified — e.g. a
  // Style whose customer link is unset AND whose leading-name token
  // matches multiple customers. Distinct from "failed" so dashboards
  // can show "needs operator action" separately from "actually broken".
  itemsSkipped Int        @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([kind])
  @@index([startedAt])
  @@map("sync_jobs")
}

enum SyncKind {
  CUSTOMERS
  SUPPLIERS
  SUPPLIER_CONTACTS
  BUSINESS_AREAS
  STYLES
  ALL
  // Ghost-DB sink ("Sync" button on the Monday page). Tracked here so
  // the admin progress UI can poll the same /api/admin/sync/progress
  // endpoint the Fill flow uses.
  SINK_ALL
  SINK_BOARD
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Laundering action a wash-care symbol concerns and a care-instruction line
// is about — the closed GINETEX set. A symbol marked `restrictive` (a "Do
// not …" symbol) removes every CareLabel tagged with the same action on
// care-label-02 (see src/lib/care-labels/visibility.ts). The exact string
// values are mirrored in src/lib/care-labels/actions.ts for the DB-free
// renderer/preview/UI layers.
enum LaunderingAction {
  WASHING
  BLEACHING
  TUMBLE_DRYING
  IRONING
  DRY_CLEANING
}

// Global wash-care symbol catalogue. Admin-managed via /settings/washcare-symbols.
// Each row holds the SVG content directly (small payloads, no need for blob
// storage). `mondayValue` is an optional free-text key used to resolve a
// Monday-emitted wash-care label back to one of these rows during ingest.
model WashSymbol {
  id           String            @id @default(cuid())
  // Stable kebab-case identifier referenced by the renderer and column
  // mapping (e.g. "wash30", "iron_low"). Unique so the renderer can do
  // O(1) lookups, and so seeding the standard set is idempotent.
  code         String            @unique
  name         String
  // Raw SVG markup. Optional so a row can be created as a placeholder
  // (code + name) and the admin uploads the file afterwards.
  svg          String?
  // Value emitted by Monday (column text or option label). Optional —
  // can be filled later when the wash-care column shape is confirmed.
  mondayValue  String?
  // Per-language care-text translations rendered on multilingual labels
  // (e.g. care-label-02 back). Keyed by ISO 639-1 lowercase language code
  // (matches Country.languageCode). Missing languages fall back to `name`.
  // Shape: { en: "Wash at 30°C", da: "Vask ved 30°", de: "30°C Wäsche", ... }
  translations Json              @default("{}")
  // The laundering action this symbol concerns ("Iron low" / "Do not iron"
  // → IRONING). Drives action-based care-instruction suppression. Nullable:
  // a symbol that maps to no laundering action suppresses nothing.
  action       LaunderingAction?
  // True for a prohibition symbol ("Do not …"). A restrictive symbol removes
  // every active CareLabel tagged with the same `action` on care-label-02 —
  // the "prohibition symbols always override extra care instructions" rule.
  restrictive  Boolean           @default(false)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([active])
  @@index([mondayValue])
  @@map("wash_symbols")
}

// =====================================================
// Certificate logos — DB-managed via /settings/certificates.
// Rendered on care-label-02 page 4. A Style declares which certificates
// apply via its Monday "__certificates__1" column (comma-separated, e.g.
// "FSC, OEKOTEX"); the renderer matches those names against this library
// (case-insensitive) and prints the logos that resolve.
// =====================================================
model Certificate {
  id        String   @id @default(cuid())
  // Display name AND the match key against a Style's certificates list.
  // Unique + matched case-insensitively in the loader.
  name      String   @unique
  // Raw SVG markup OR a data URL ("data:image/png;base64,…"). Same dual
  // storage convention as WashSymbol.svg. Optional so a row can be a
  // placeholder until artwork is uploaded.
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("certificates")
}

// =====================================================
// Care labels — DB-managed via /settings/care-labels.
// Each row is one care-instruction line printed on care-label-02. Add as
// many as needed; print order is `sortOrder`. The line's per-language text
// is resolved from the Translation dictionary at render time (sourceText
// is the lookup key), so translations live on the Monday translations
// board, not here.
//
// Primary visibility rule is action-based: a line tagged with `action`
// (e.g. IRONING) is removed whenever the style carries a restrictive symbol
// of the same action ("Do not iron"). Splitting compound lines into atomic
// action-tagged ones ("wash inside out" + "iron inside out") lets a single
// prohibition drop just the offending part — the renderer composes only the
// survivors. `action` null ⇒ never auto-suppressed.
//
// showIfSymbols / hideIfSymbols are a manual override on top, matched
// against a style's wash-care symbol CODES:
//   showIfSymbols  — if non-empty, the line shows ONLY when at least one
//                    of these symbols is present on the style.
//   hideIfSymbols  — if non-empty, the line is HIDDEN when at least one of
//                    these symbols is present. Hide (manual or action) wins.
// =====================================================
model CareLabel {
  id            String            @id @default(cuid())
  sourceText    String
  sortOrder     Int               @default(0)
  // Laundering action this line's text is about. Auto-removed by a present
  // restrictive symbol of the same action. See LaunderingAction.
  action        LaunderingAction?
  showIfSymbols Json              @default("[]")
  hideIfSymbols Json              @default("[]")
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([active])
  @@map("care_labels")
}

// =====================================================
// Info Area Sizes — admin-managed catalogue of named print sizes (mm) for
// "info area" outputs (OutputLayout.isInfoArea). On a style's info-area
// output the operator picks one of these (or a one-time custom size); the
// renderer prints the layout at the chosen dimensions. DB-managed via
// /settings/info-area-sizes, mirroring the CareLabel / QrImage CRUD.
// =====================================================
model InfoAreaSize {
  id        String   @id @default(cuid())
  name      String
  // Millimetres — fractional allowed (e.g. 27.5). Float, not Int, so sizes
  // like 27,5 mm round-trip. The UI accepts a comma or dot decimal.
  widthMm   Float
  heightMm  Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("info_area_sizes")
}

// =====================================================
// QR images — DB-managed via /settings/qr-codes.
// A Style links to at most one (Style.qrImageId); care-label-02 page 4
// renders it as-is. The image source is uploaded by the operator — we
// don't generate QR codes, we just store and place the picture.
// =====================================================
model QrImage {
  id        String   @id @default(cuid())
  name      String
  // Image data URL ("data:image/png;base64,…" / svg). Required — a QR
  // entry with no image is meaningless.
  image     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  styles Style[]

  @@index([active])
  @@map("qr_images")
}

// =====================================================
// Translation dictionary — the canonical English→multilang store, sync'd
// from Monday board 9671510799 ("ALL translations": wash-care phrases,
// care-label text, "Made in <country>" lines, …).
//
// Replaces the hardcoded MADE_IN_PHRASE / COUNTRY_NAMES tables and the
// ProdSpec.careInstructionsByLang stopgap: the renderer normalises an
// English phrase to `key` and reads the per-language string from
// `translations` (same JSON-keyed-by-Language.code convention as
// WashSymbol.translations / Country.nameTranslations). Missing languages
// fall back to `sourceText`.
// =====================================================
model Translation {
  id           String    @id @default(cuid())
  // Normalised lookup key (lowercased, whitespace-collapsed) derived from
  // sourceText. Unique so sync is idempotent and renderer lookups are O(1);
  // the renderer normalises its query the same way. Board duplicates of the
  // same English phrase collapse onto one row (their translations match).
  key          String    @unique
  // Original English phrase as it appears on the board (Monday item Name).
  // The canonical fallback when a language is missing.
  sourceText   String
  // Per-language translations keyed by Language.code (lowercase ISO 639-1
  // + optional region, e.g. "de-AT"). Shape: { da: "…", de: "…", fr: "…" }.
  translations Json      @default("{}")
  // Monday group the phrase came from ("Translations", "translation new
  // words") — informational, handy for admin filtering. Optional.
  category     String?
  // Source ghost item id (board 9671510799). Indexed, not unique — multiple
  // items can normalise to the same `key`; we upsert by `key`.
  mondayItemId String?
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
  @@index([mondayItemId])
  @@map("translations")
}

// =====================================================
// Monday "ghost" tables — raw API sink, board-agnostic.
//
// Every board we know about lands here unmodified: its metadata in
// MondayGhostBoard, its column definitions (with parsed `settings_str`)
// in MondayGhostColumn, every item's column_values JSON in
// MondayGhostItem, and every dropdown/status label flattened into
// MondayGhostDropdownOption.
//
// These tables exist so we can sync first and decide later — the typed
// domain mirrors (Customer, Supplier, Style, BusinessArea, WashSymbol,
// ...) get populated from ghost rows by separate transformers. Useful
// for new boards we haven't fully mapped yet (e.g. the Pre Order board
// 7322835224) and for inspecting dropdown sources before seeding a
// downstream catalog.
//
// As with MondayWebhook, deletions of upstream rows must never delete
// ghost rows from code — we only stamp `lastSyncedAt`. Operators clean
// up ghost data by hand if needed.
// =====================================================

model MondayGhostBoard {
  id            String    @id @default(cuid())
  // Monday's numeric board id — what env vars and webhooks reference.
  mondayBoardId String    @unique
  // Board name as Monday returns it. Re-synced on every sink run.
  name          String
  description   String?
  // Friendly label shown in the admin nav ("Pre Order", "Styles",
  // "Customers"). Editable separate from Monday's name so we can rename
  // for our UI without confusing the source-of-truth field.
  label         String?
  itemCount     Int       @default(0)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  columns MondayGhostColumn[]
  items   MondayGhostItem[]

  @@map("monday_ghost_boards")
}

model MondayGhostColumn {
  id             String    @id @default(cuid())
  boardId        String
  // Column id as Monday emits it (e.g. "dropdown_mktbzd1f", "name").
  mondayColumnId String
  title          String
  // Raw Monday column type — "text", "dropdown", "status", "board_relation",
  // "numbers", "people", "country", "link", "mirror", ...
  type           String
  description    String?
  // Parsed `settings_str` JSON — includes the labels[] array for
  // dropdowns/statuses, board_ids for board_relation, etc.
  settings       Json      @default("null")
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  board   MondayGhostBoard            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  options MondayGhostDropdownOption[]

  @@unique([boardId, mondayColumnId])
  @@index([boardId])
  @@index([type])
  @@map("monday_ghost_columns")
}

model MondayGhostItem {
  id           String   @id @default(cuid())
  boardId      String
  // Monday's item id — same value Style.mondayItemId, Customer.mondayItemId
  // etc. reference. Unique within a board.
  mondayItemId String
  name         String
  groupId      String?
  groupTitle   String?
  // Full `column_values` array as Monday returns it — each entry is
  // { id, type, text, value (parsed JSON or null) }. We store this raw
  // so downstream transformers can read whatever shape they need.
  columnValues Json     @default("[]")
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  board MondayGhostBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, mondayItemId])
  @@index([boardId])
  @@index([name])
  @@map("monday_ghost_items")
}

// Flattened dropdown / status labels. One row per (column, optionId).
// Source for seeding downstream catalogs (WashSymbol, future Trim,
// Size, Composition catalogs) — the seed scripts pick the rows whose
// boardColumn matches the configured Monday column id.
model MondayGhostDropdownOption {
  id            String   @id @default(cuid())
  boardColumnId String
  // Monday's option id (stringified — numeric in JSON but stored as
  // text so it survives changes in numeric encoding).
  optionId      String
  label         String
  // Monday's color id for the option (status columns mostly). Null for
  // dropdowns that don't carry a color.
  color         String?
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  boardColumn MondayGhostColumn @relation(fields: [boardColumnId], references: [id], onDelete: Cascade)

  @@unique([boardColumnId, optionId])
  @@index([boardColumnId])
  @@index([label])
  @@map("monday_ghost_dropdown_options")
}

// Editable AI system prompts, keyed by a stable slug (e.g. "rejection-fix").
// A row OVERRIDES the built-in default for that key; an absent row means the
// code default is used. Admins edit these under Settings → Prompts. Kept
// generic so a future AI feature registers its own key + default in code
// (src/lib/prompts/system-prompts.ts) without a schema change.
model SystemPrompt {
  id             String   @id @default(cuid())
  key            String   @unique
  content        String
  // Email of the admin who last saved (display only — no FK, so a deleted
  // user never orphans the prompt).
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("system_prompts")
}

// =====================================================
// Layout images — DB-managed via /settings/images.
// Reusable artwork placed by the Output Builder's {{image:<slug>}} token.
//
// The distinction from OutputLayout.customLogo ({{logo:custom}}): that is
// ONE image per layout, stored on the layout row. These are a SHARED
// library — a layout can place as many as it likes, and the same picture
// is reused across layouts, so updating the artwork here updates every
// layout that places it. Mirrors the Certificate / QrImage libraries.
// =====================================================
model LayoutImage {
  id     String  @id @default(cuid())
  // Human name — shown in the library and as the builder palette chip.
  name   String
  // The token argument: {{image:<slug>}}. Lowercase [a-z0-9-], unique.
  // The slug IS the contract with published layout definitions, so
  // renaming one orphans every layout that places it — the renderer then
  // prints a `missing` chip, which blocks approval rather than silently
  // shipping a blank. Rename deliberately.
  slug   String  @unique
  // Raw SVG markup OR a data URL ("data:image/png;base64,…"). Same dual
  // storage as Certificate.logo / WashSymbol.svg. Optional so a row can be
  // a placeholder until the artwork arrives.
  image  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("layout_images")
}

// One row per (supplier, purchase order) — the last known answer to "did every
// approved document for this PO actually reach the supplier's folder?".
//
// Why this is stored rather than computed on demand: answering it costs ~5
// sequential Graph calls per folder plus a current-outputs walk per style on
// it. A fleet list of a few hundred POs cannot do that at render time, and the
// whole point of the list is to surface the folder nobody thought to open. The
// cron sweep fills these in on rotation; the detail page re-checks live, so a
// stale row is never what a repair acts on.
//
// Counts only, no ledger payload: the list needs "22 of 68", and keeping the
// per-document breakdown here would bloat every row to carry a picture that is
// already out of date by the time anyone opens it.
model PoDeliveryCheck {
  id         String  @id @default(cuid())
  supplierId String
  poNumber   String
  // Parsed PO number, for ordering the list newest-first without re-deriving
  // it from the string (see table-sort.ts for why the string is never sorted).
  poSeq      Int?
  supplierName String?

  // ReconcileState. Anything other than "ok"/"subfolder-missing" means the
  // folder could not be listed and the counts below are NOT evidence of
  // anything — a 403 must never read as "the files are gone".
  state   String
  // One human sentence: the delivery headline when listable, the state's own
  // explanation when not.
  message String?
  folderUrl String?

  styleCount    Int @default(0)
  expectedDocs  Int @default(0)
  deliveredDocs Int @default(0)
  missingDocs   Int @default(0)
  renamedDocs   Int @default(0)
  // Documents that CANNOT land because another document on the same PO claims
  // their file name. A naming defect, not a transfer failure — deliberately its
  // own number so a repair never tries to push its way out of it.
  collisionDocs Int @default(0)
  strayFiles    Int @default(0)
  staleFiles    Int @default(0)

  fullyDelivered Boolean  @default(false)
  checkedAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, poNumber])
  @@index([fullyDelivered, poSeq])
  @@index([checkedAt])
  @@map("po_delivery_checks")
}
